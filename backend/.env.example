# --- FastAPI ---
FSP_APP_NAME=FSP обратный найм
FSP_DEBUG=true
FSP_API_V1_PREFIX=/api/v1

# --- База данных ---
FSP_DATABASE_URL=postgresql+asyncpg://fsp:fsp@db:5432/fsp

# --- Сессии (NFR-02: HttpOnly cookie, SameSite) ---
FSP_SESSION_COOKIE_NAME=fsp_session
FSP_CSRF_COOKIE_NAME=fsp_csrf
FSP_SESSION_TTL_SECONDS=86400
FSP_COOKIE_SECURE=false
FSP_COOKIE_SAMESITE=lax

# --- Почта (FR-02). backend=log | smtp ---
FSP_MAIL_BACKEND=log
FSP_SMTP_HOST=
FSP_SMTP_PORT=1025
FSP_SMTP_USER=
FSP_SMTP_PASSWORD=
FSP_MAIL_FROM=FSP Platform <noreply@fsp.local>
FSP_CONFIRM_BASE_URL=http://localhost:5173/confirm-email

# --- CORS ---
FSP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173