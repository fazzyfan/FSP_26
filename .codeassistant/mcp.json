{
	"mcpServers": {
		"memory": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"-v",
				"mcp-memory:/app/dist",
				"--rm",
				"mcp/memory"
			],
			"disabledTools": [],
			"alwaysAllow": [
				"create_entities",
				"create_relations",
				"add_observations",
				"delete_entities",
				"delete_observations",
				"delete_relations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			]
		},
		"sequentialthinking": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"disabledTools": [],
			"alwaysAllow": [
				"sequentialthinking"
			]
		}
	}
}